# filter by group
def filter_group():
    group = input("Group: ")

    cur.execute("""
    SELECT c.first_name, c.email
    FROM phonebook c
    JOIN groups g ON c.group_id = g.id
    WHERE g.name = %s
    """, (group,))

    print(cur.fetchall())

