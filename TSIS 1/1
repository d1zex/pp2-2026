# import json
def import_json():
    path = input("Path: ")

    with open(path) as f:
        data = json.load(f)

    for c in data:
        name = c[0]
        email = c[1]

        cur.execute("SELECT 1 FROM phonebook WHERE first_name=%s", (name,))
        if cur.fetchone():
            choice = input(f"{name} exists (skip/overwrite): ")
            if choice == "skip":
                continue
            else:
                cur.execute("DELETE FROM phonebook WHERE first_name=%s", (name,))

        cur.execute("INSERT INTO phonebook(first_name,email) VALUES (%s,%s)", (name, email))

    conn.commit()
    print("Imported")

