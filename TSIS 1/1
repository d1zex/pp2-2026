# validation
def is_valid_phone(phone):
    return re.fullmatch(r"\+7\d{10}", phone) is not None

# add contact
def insert_from_console():
    name = input("Name: ")
    phone = input("Phone: ")

    if not is_valid_phone(phone):
        print("Invalid phone")
        return

    cur.execute("CALL upsert_contact(%s, %s)", (name, phone))
    conn.commit()

# search simple
def search_pattern():
    q = input("Search: ")
    cur.execute("SELECT * FROM get_contacts_by_pattern(%s)", (q,))
    print(cur.fetchall())

# pagination
def show_contacts():
    page = 0
    limit = 5

    while True:
        cur.execute("SELECT * FROM get_contacts_paginated(%s,%s)", (limit, page*limit))
        rows = cur.fetchall()

        if not rows:
            print("No data")
            break

        print(f"\nPage {page+1}")
        for r in rows:
            print(r)

        action = input("n/p/q: ")

        if action == "n":
            page += 1
        elif action == "p" and page > 0:
            page -= 1
        elif action == "q":
            break

